<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Edit Profile - AlumniAI' }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container py-4" style="max-width:700px;">
    <h1 class="mb-3" style="font-size:24px;">Edit My Profile</h1>
    <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>
    <form method="POST" action="/alumni/profile/edit" class="card p-4" novalidate>
      <div class="mb-2"><label class="form-label" for="name">Name</label><input id="name" class="form-control" name="name" value="<%= profile.name %>" required></div>
      <div class="row">
        <div class="col mb-2">
          <label class="form-label" for="branch">Branch</label>
          <input id="branch" class="form-control" name="branch" value="<%= profile.department_name || '' %>" list="branchOptions">
          <datalist id="branchOptions">
            <option value="Computer Engineering"><option value="Information Technology">
            <option value="Mechanical Engineering"><option value="Civil Engineering">
            <option value="Electrical Engineering"><option value="Electronics & Communication Engineering">
          </datalist>
        </div>
        <div class="col mb-2"><label class="form-label" for="grad">Graduation Year</label><input type="number" id="grad" class="form-control" name="graduation_year" value="<%= profile.graduation_year || '' %>"></div>
      </div>
      <div class="row">
        <div class="col mb-2"><label class="form-label" for="company">Company</label><input id="company" class="form-control" name="company" value="<%= profile.company_name || '' %>"></div>
        <div class="col mb-2"><label class="form-label" for="job_role">Job Role</label><input id="job_role" class="form-control" name="job_role" value="<%= profile.job_role || '' %>"></div>
      </div>
      <div class="mb-2"><label class="form-label" for="location">Location</label><input id="location" class="form-control" name="location" value="<%= profile.location || '' %>" placeholder="City, Country"></div>
      <div class="mb-2"><label class="form-label" for="bio">Bio</label><textarea id="bio" class="form-control" name="bio" rows="3"><%= profile.bio || '' %></textarea></div>
      <div class="row">
        <div class="col mb-2"><label class="form-label" for="linkedin_url">LinkedIn URL</label><input id="linkedin_url" class="form-control" name="linkedin_url" value="<%= profile.linkedin_url || '' %>"></div>
        <div class="col mb-2"><label class="form-label" for="github_url">GitHub URL</label><input id="github_url" class="form-control" name="github_url" value="<%= profile.github_url || '' %>"></div>
      </div>
      <div class="mb-2"><label class="form-label" for="experience_years">Experience (years)</label><input type="number" step="0.5" id="experience_years" class="form-control" name="experience_years" value="<%= profile.experience_years || '' %>"></div>

      <div class="mb-2">
        <label class="form-label" for="skills">Skills</label>
        <input id="skills" class="form-control" name="skills" value="<%= profile.skills.join(', ') %>"
          data-chip-input
          data-placeholder="Type a skill and press Enter..."
          data-suggestions='["JavaScript","Python","Java","C++","React","Node.js","PostgreSQL","AWS","Docker","Kubernetes","Penetration Testing","Network Security","TensorFlow","PyTorch","Data Analysis","Product Strategy","Figma","System Design"]'>
      </div>
      <div class="mb-3">
        <label class="form-label" for="interests">Interests</label>
        <input id="interests" class="form-control" name="interests" value="<%= profile.interests.join(', ') %>"
          data-chip-input
          data-placeholder="Type an interest and press Enter..."
          data-suggestions='["Artificial Intelligence","Machine Learning","Cybersecurity","Web Development","Cloud Computing","DevOps","Data Science","Mobile Development","Product Management","Entrepreneurship","UI/UX Design","Finance"]'>
      </div>

      <div class="form-check mb-2">
        <input type="checkbox" class="form-check-input" name="mentorship_available" id="mentorship" <%= profile.mentorship_available ? 'checked' : '' %>>
        <label class="form-check-label" for="mentorship">Available for mentorship</label>
      </div>
      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" name="referral_available" id="referral" <%= profile.referral_available ? 'checked' : '' %>>
        <label class="form-check-label" for="referral">Available for referrals</label>
      </div>
      <button class="btn btn-primary w-100" type="submit">Save Changes</button>
    </form>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/chip-input.js"></script>
</body>
</html>
