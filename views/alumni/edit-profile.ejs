<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Profile - Alumni Career Intelligence</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container py-4" style="max-width:700px;">
    <h3 class="mb-3">Edit My Profile</h3>
    <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
    <form method="POST" action="/alumni/profile/edit" class="card p-4">
      <div class="mb-2"><label class="form-label">Name</label><input class="form-control" name="name" value="<%= profile.name %>" required></div>
      <div class="row">
        <div class="col mb-2"><label class="form-label">Branch</label><input class="form-control" name="branch" value="<%= profile.department_name || '' %>"></div>
        <div class="col mb-2"><label class="form-label">Graduation Year</label><input type="number" class="form-control" name="graduation_year" value="<%= profile.graduation_year || '' %>"></div>
      </div>
      <div class="row">
        <div class="col mb-2"><label class="form-label">Company</label><input class="form-control" name="company" value="<%= profile.company_name || '' %>"></div>
        <div class="col mb-2"><label class="form-label">Job Role</label><input class="form-control" name="job_role" value="<%= profile.job_role || '' %>"></div>
      </div>
      <div class="mb-2"><label class="form-label">Location</label><input class="form-control" name="location" value="<%= profile.location || '' %>"></div>
      <div class="mb-2"><label class="form-label">Bio</label><textarea class="form-control" name="bio" rows="3"><%= profile.bio || '' %></textarea></div>
      <div class="row">
        <div class="col mb-2"><label class="form-label">LinkedIn URL</label><input class="form-control" name="linkedin_url" value="<%= profile.linkedin_url || '' %>"></div>
        <div class="col mb-2"><label class="form-label">GitHub URL</label><input class="form-control" name="github_url" value="<%= profile.github_url || '' %>"></div>
      </div>
      <div class="mb-2"><label class="form-label">Experience (years)</label><input type="number" step="0.5" class="form-control" name="experience_years" value="<%= profile.experience_years || '' %>"></div>
      <div class="mb-2"><label class="form-label">Skills (comma-separated)</label><input class="form-control" name="skills" value="<%= profile.skills.join(', ') %>"></div>
      <div class="mb-2"><label class="form-label">Interests (comma-separated)</label><input class="form-control" name="interests" value="<%= profile.interests.join(', ') %>"></div>
      <div class="form-check mb-2">
        <input type="checkbox" class="form-check-input" name="mentorship_available" id="mentorship" <%= profile.mentorship_available ? 'checked' : '' %>>
        <label class="form-check-label" for="mentorship">Available for mentorship</label>
      </div>
      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" name="referral_available" id="referral" <%= profile.referral_available ? 'checked' : '' %>>
        <label class="form-check-label" for="referral">Available for referrals</label>
      </div>
      <button class="btn btn-primary w-100" type="submit">Save Changes</button>
    </form>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
