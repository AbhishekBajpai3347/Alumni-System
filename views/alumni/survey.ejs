<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Alumni Survey - AlumniAI' }) %>
</head>
<body>
  <div class="survey-progress-wrap">
    <div class="container">
      <div id="surveyProgressLabel" class="small fw-semibold mb-1" style="color: var(--text-heading);">Section 1</div>
      <div class="survey-progress-track"><div id="surveyProgressFill" class="survey-progress-fill" style="width:0%;"></div></div>
    </div>
  </div>

  <main class="container py-4" style="max-width:800px;">
    <h1 class="mb-1" style="font-size:24px;">Alumni Career &amp; College Experience Survey</h1>
    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <p class="text-muted mb-0">This helps students find you and get relevant advice. Takes about 5 minutes.</p>
      </div>
      <form method="POST" action="/alumni/survey/skip" class="m-0">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Skip for now</button>
      </form>
    </div>
    <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>

    <form method="POST" action="/alumni/survey" novalidate>
      <%
        // Group questions by section while preserving order, for client-side pagination.
        const sectionsMap = [];
        questions.forEach(q => {
          let bucket = sectionsMap.find(s => s.name === q.section);
          if (!bucket) { bucket = { name: q.section, items: [] }; sectionsMap.push(bucket); }
          bucket.items.push(q);
        });
      %>

      <% sectionsMap.forEach((section, sIdx) => { %>
        <div class="survey-section" data-section-name="<%= section.name %>">
          <h2 class="mb-3" style="font-size:19px;"><%= section.name %></h2>

          <% section.items.forEach(q => {
            const key = 'q' + q.no;
            const existingVal = existing[q.no];
          %>
            <div class="card p-3 mb-3">
              <label class="form-label small fw-bold"><%= q.no %>. <%= q.text %></label>

              <% if (q.type === 'single') { %>
                <% q.options.forEach(opt => { %>
                  <div class="option-check-wrap">
                    <input class="form-check-input m-0" type="radio" name="<%= key %>" value="<%= opt %>" id="<%= key %>_<%= opt.replace(/\W+/g,'_') %>"
                      <%= existingVal === opt ? 'checked' : '' %>>
                    <label class="form-check-label" for="<%= key %>_<%= opt.replace(/\W+/g,'_') %>"><%= opt %></label>
                  </div>
                <% }) %>
              <% } else if (q.type === 'multi') { %>
                <% q.options.forEach(opt => { %>
                  <div class="option-check-wrap">
                    <input class="form-check-input m-0" type="checkbox" name="<%= key %>" value="<%= opt %>" id="<%= key %>_<%= opt.replace(/\W+/g,'_') %>"
                      <%= Array.isArray(existingVal) && existingVal.includes(opt) ? 'checked' : '' %>>
                    <label class="form-check-label" for="<%= key %>_<%= opt.replace(/\W+/g,'_') %>"><%= opt %></label>
                  </div>
                <% }) %>
              <% } else if (q.type === 'integer') { %>
                <input type="number" class="form-control" style="max-width:200px;" min="0" name="<%= key %>" value="<%= existingVal !== undefined ? existingVal : '' %>">
              <% } else { %>
                <textarea class="form-control" name="<%= key %>" rows="3" maxlength="500" data-charcount="counter_<%= key %>"><%= existingVal !== undefined ? existingVal : '' %></textarea>
                <span class="char-counter" id="counter_<%= key %>">0/500</span>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% }) %>

      <div class="d-flex justify-content-between align-items-center mt-4 mb-5">
        <button type="button" id="surveyPrevBtn" class="btn btn-outline-secondary">← Previous</button>
        <button type="button" id="surveyNextBtn" class="btn btn-primary">Next →</button>
        <button type="submit" id="surveySubmitBtn" class="btn btn-primary" style="display:none;">Submit Survey</button>
      </div>
    </form>
  </main>

  <script src="/js/theme.js"></script>
  <script src="/js/survey.js"></script>
</body>
</html>
