<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Career Journey - AlumniAI' }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container py-4" style="max-width:700px;">
    <h1 class="mb-3" style="font-size:24px;">My Career Journey</h1>
    <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>

    <% if (profile.journey.length === 0) { %>
      <div class="card empty-state mb-3"><span class="empty-icon">💼</span>No career journey entries yet. Add your first one below.</div>
    <% } else { %>
      <div class="timeline mb-4">
        <% profile.journey.slice().reverse().forEach(j => { %>
          <div class="timeline-item">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
              <div>
                <div class="fw-bold" style="color: var(--text-heading);"><%= j.role %> <span class="text-muted fw-normal">at <%= j.company_name || 'N/A' %></span></div>
                <div class="small text-muted">
                  <%= j.start_date ? new Date(j.start_date).toLocaleDateString() : '?' %>
                  &ndash;
                  <%= j.end_date ? new Date(j.end_date).toLocaleDateString() : 'Present' %>
                </div>
                <% if (j.description) { %><div class="small mt-1"><%= j.description %></div><% } %>
              </div>
              <form method="POST" action="/alumni/career/<%= j.id %>/delete">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="card p-3">
      <h3 style="font-size:16px;">Add Career Entry</h3>
      <form method="POST" action="/alumni/career" novalidate>
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label small" for="company">Company</label>
            <input id="company" class="form-control" name="company" placeholder="Company" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small" for="role">Role</label>
            <input id="role" class="form-control" name="role" placeholder="Role" required>
          </div>
        </div>
        <div class="row g-2 mt-1">
          <div class="col-md-6">
            <label class="form-label small" for="start_date">Start Date</label>
            <input type="date" id="start_date" class="form-control" name="start_date">
          </div>
          <div class="col-md-6">
            <label class="form-label small" for="end_date">End Date (leave blank if current)</label>
            <input type="date" id="end_date" class="form-control" name="end_date">
          </div>
        </div>
        <div class="mt-2">
          <label class="form-label small" for="description">Description</label>
          <textarea id="description" class="form-control" name="description" rows="2" placeholder="Optional description"></textarea>
        </div>
        <button class="btn btn-primary mt-3" type="submit">Add Entry</button>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
