<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Career Journey - Alumni Career Intelligence</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container py-4" style="max-width:700px;">
    <h3 class="mb-3">My Career Journey</h3>
    <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>

    <% if (profile.journey.length === 0) { %>
      <div class="empty-state mb-3">No career journey entries yet. Add your first one below.</div>
    <% } else { %>
      <div class="timeline mb-4">
        <% profile.journey.forEach(j => { %>
          <div class="timeline-item">
            <div class="d-flex justify-content-between">
              <div>
                <div class="fw-bold"><%= j.role %> <span class="text-muted fw-normal">at <%= j.company_name || 'N/A' %></span></div>
                <div class="small text-muted">
                  <%= j.start_date ? new Date(j.start_date).toLocaleDateString() : '?' %>
                  &ndash;
                  <%= j.end_date ? new Date(j.end_date).toLocaleDateString() : 'Present' %>
                </div>
                <% if (j.description) { %><div class="small mt-1"><%= j.description %></div><% } %>
              </div>
              <form method="POST" action="/alumni/career/<%= j.id %>/delete">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="card p-3">
      <h6>Add Career Entry</h6>
      <form method="POST" action="/alumni/career">
        <div class="row g-2">
          <div class="col-md-6"><input class="form-control" name="company" placeholder="Company" required></div>
          <div class="col-md-6"><input class="form-control" name="role" placeholder="Role" required></div>
        </div>
        <div class="row g-2 mt-1">
          <div class="col-md-6">
            <label class="form-label small">Start Date</label>
            <input type="date" class="form-control" name="start_date">
          </div>
          <div class="col-md-6">
            <label class="form-label small">End Date (leave blank if current)</label>
            <input type="date" class="form-control" name="end_date">
          </div>
        </div>
        <div class="mt-2"><textarea class="form-control" name="description" rows="2" placeholder="Description (optional)"></textarea></div>
        <button class="btn btn-primary mt-2" type="submit">Add Entry</button>
      </form>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
