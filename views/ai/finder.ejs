<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'AI Finder - AlumniAI' }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container py-4">
    <div class="ai-banner mb-3">
      <h3>✦ AI-Powered Alumni Search</h3>
      <p>Describe who you're looking for in plain English — our AI will understand your query and find the best-matching alumni.</p>
    </div>

    <div class="card p-3 mb-3">
      <label class="form-label" for="aiQuery">Your query</label>
      <textarea id="aiQuery" class="form-control mb-2" rows="4" style="min-height:120px;"
        placeholder="e.g. I want to find an alumnus working in cybersecurity who can guide me on internships and CTF competitions."></textarea>
      <button id="aiSearchBtn" class="btn btn-ai">Find with AI ✦</button>
    </div>

    <div id="aiLoading" class="text-center py-4" style="display:none;">
      <div class="spinner-border" role="status" style="color: var(--accent-purple);"></div>
      <p id="aiLoadingMessage" class="text-muted mt-2 mb-0">Analysing query…</p>
    </div>

    <div id="aiError" class="alert alert-danger" role="alert" style="display:none;"></div>

    <div id="aiStructured" class="mb-3" style="display:none;">
      <div class="alert alert-ai mb-0">
        <div class="small fw-semibold mb-1">Extracted requirements</div>
        <div id="aiStructuredContent" class="small"></div>
      </div>
    </div>

    <div id="aiResults" class="row g-3"></div>

    <div id="aiEmpty" class="card empty-state" style="display:none;">
      <span class="empty-icon">🤖</span>
      <h3 style="font-size:16px;">No matching alumni found</h3>
      <p class="mb-0">Try rephrasing your query or use the <a href="/alumni/finder">regular Alumni Finder</a>.</p>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/ai-finder.js"></script>
</body>
</html>
