<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Edit Profile - AlumniAI' }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container py-4" style="max-width:640px;">
    <h1 class="mb-3" style="font-size:24px;">Edit My Profile</h1>
    <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>
    <form method="POST" action="/student/profile/edit" class="card p-4" novalidate>
      <div class="mb-2"><label class="form-label" for="name">Name</label><input id="name" class="form-control" name="name" value="<%= profile.name %>" required></div>
      <div class="row">
        <div class="col mb-2">
          <label class="form-label" for="branch">Branch</label>
          <input id="branch" class="form-control" name="branch" value="<%= profile.branch || '' %>" list="branchOptions">
          <datalist id="branchOptions">
            <option value="Computer Engineering"><option value="Information Technology">
            <option value="Mechanical Engineering"><option value="Civil Engineering">
            <option value="Electrical Engineering"><option value="Electronics & Communication Engineering">
          </datalist>
        </div>
        <div class="col mb-2">
          <label class="form-label" for="year">Year</label>
          <select id="year" class="form-select" name="year">
            <option value="">Select</option>
            <% [1,2,3,4,5].forEach(y => { %>
              <option value="<%= y %>" <%= String(profile.year) === String(y) ? 'selected' : '' %>><%= y %><%= y === 1 ? 'st' : y === 2 ? 'nd' : y === 3 ? 'rd' : 'th' %> Year</option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="mb-2"><label class="form-label" for="grad">Graduation Year</label><input type="number" id="grad" class="form-control" name="graduation_year" value="<%= profile.graduation_year || '' %>"></div>
      <div class="mb-3">
        <label class="form-label" for="interests">Interests</label>
        <input id="interests" class="form-control" name="interests" value="<%= profile.interests.join(', ') %>"
          data-chip-input
          data-placeholder="Type an interest and press Enter..."
          data-suggestions='["Artificial Intelligence","Machine Learning","Cybersecurity","Web Development","Cloud Computing","DevOps","Data Science","Mobile Development","Product Management","Entrepreneurship","UI/UX Design","Finance"]'>
      </div>
      <button class="btn btn-primary w-100" type="submit">Save Changes</button>
    </form>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/chip-input.js"></script>
</body>
</html>
