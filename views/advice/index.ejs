<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Advice - AlumniAI' }) %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="container py-4" style="max-width:800px;">
    <h1 class="mb-3" style="font-size:24px;">💬 Advice</h1>

    <% if (user.role === 'student') { %>
      <div class="card p-3 mb-4">
        <h3 style="font-size:16px;">Ask a Question</h3>
        <form method="POST" action="/advice/questions">
          <label class="form-label small" for="questionInput">Your question</label>
          <textarea id="questionInput" class="form-control mb-2" name="question" rows="2" placeholder="e.g. How do I prepare for a data science internship?" required></textarea>
          <button class="btn btn-primary btn-sm" type="submit">Post Question</button>
        </form>
      </div>
    <% } %>

    <% if (questions.length === 0) { %>
      <div class="card empty-state"><span class="empty-icon">💬</span>No questions yet. Be the first to ask!</div>
    <% } %>

    <% questions.forEach(q => { %>
      <div class="card p-3 mb-3">
        <div class="fw-bold mb-1" style="color:var(--text-heading);">Q: <%= q.question %></div>
        <div class="small text-muted mb-2">asked by <%= q.student_name %> · <%= q.answers.length %> answer<%= q.answers.length === 1 ? '' : 's' %></div>

        <% if (q.answers.length === 0) { %>
          <div class="small text-muted fst-italic mb-2">Be the first to answer this question!</div>
        <% } %>

        <% q.answers.forEach(a => { %>
          <div class="border-start border-3 ps-2 mb-2" style="border-color: var(--accent-primary) !important;">
            <div class="small"><%= a.answer %></div>
            <div class="small text-muted">&mdash; <%= a.alumni_name %></div>
            <% if (myAlumniId && myAlumniId === a.alumni_id) { %>
              <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="collapse" data-bs-target="#edit-<%= a.id %>">Edit</button>
              <form method="POST" action="/advice/answers/<%= a.id %>/edit" class="collapse mt-1" id="edit-<%= a.id %>">
                <textarea class="form-control form-control-sm mb-1" name="answer" rows="2"><%= a.answer %></textarea>
                <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
              </form>
            <% } %>
          </div>
        <% }) %>

        <% if (user.role === 'alumni') { %>
          <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="collapse" data-bs-target="#answer-<%= q.id %>">Answer this question</button>
          <form method="POST" action="/advice/questions/<%= q.id %>/answers" class="collapse mt-1" id="answer-<%= q.id %>">
            <textarea class="form-control form-control-sm mb-1" name="answer" rows="2" placeholder="Write your answer..." required></textarea>
            <button class="btn btn-sm btn-primary" type="submit">Submit Answer</button>
          </form>
        <% } %>
      </div>
    <% }) %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
