<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Advice - Alumni Career Intelligence</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container py-4" style="max-width:800px;">
    <h3 class="mb-3">💬 Advice</h3>

    <% if (user.role === 'student') { %>
      <div class="card p-3 mb-4">
        <h6>Ask a Question</h6>
        <form method="POST" action="/advice/questions">
          <textarea class="form-control mb-2" name="question" rows="2" placeholder="e.g. How do I prepare for a data science internship?" required></textarea>
          <button class="btn btn-primary btn-sm" type="submit">Post Question</button>
        </form>
      </div>
    <% } %>

    <% if (questions.length === 0) { %>
      <div class="empty-state">No questions yet. Be the first to ask!</div>
    <% } %>

    <% questions.forEach(q => { %>
      <div class="card p-3 mb-3">
        <div class="fw-bold mb-1">Q: <%= q.question %></div>
        <div class="small text-muted mb-2">asked by <%= q.student_name %></div>

        <% q.answers.forEach(a => { %>
          <div class="border-start border-3 border-primary ps-2 mb-2">
            <div class="small"><%= a.answer %></div>
            <div class="small text-muted">&mdash; <%= a.alumni_name %></div>
            <% if (myAlumniId && myAlumniId === a.alumni_id) { %>
              <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="collapse" data-bs-target="#edit-<%= a.id %>">Edit</button>
              <form method="POST" action="/advice/answers/<%= a.id %>/edit" class="collapse mt-1" id="edit-<%= a.id %>">
                <textarea class="form-control form-control-sm mb-1" name="answer" rows="2"><%= a.answer %></textarea>
                <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
              </form>
            <% } %>
          </div>
        <% }) %>

        <% if (user.role === 'alumni') { %>
          <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="collapse" data-bs-target="#answer-<%= q.id %>">Answer this question</button>
          <form method="POST" action="/advice/questions/<%= q.id %>/answers" class="collapse mt-1" id="answer-<%= q.id %>">
            <textarea class="form-control form-control-sm mb-1" name="answer" rows="2" placeholder="Write your answer..." required></textarea>
            <button class="btn btn-sm btn-primary" type="submit">Submit Answer</button>
          </form>
        <% } %>
      </div>
    <% }) %>
  </div>
  <%- include('../partials/footer') %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
</body>
</html>
