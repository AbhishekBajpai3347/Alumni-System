<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Login - AlumniAI' }) %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card" style="max-width:440px;">
      <h1 class="text-center mb-1" style="font-size:26px;">🎓 Welcome Back</h1>
      <p class="text-center text-muted mb-4">Log in to your AlumniAI account</p>
      <% if (error) { %>
        <div class="alert alert-danger py-2" role="alert"><%= error %></div>
      <% } %>
      <form method="POST" action="/auth/login" novalidate>
        <div class="mb-3">
          <label class="form-label" for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
      </form>
      <p class="text-center mt-3 mb-0 small">No account? <a href="/auth/register">Register here</a></p>
    </div>
  </div>
</body>
</html>
