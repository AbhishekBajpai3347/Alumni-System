<% if (typeof user !== 'undefined' && user) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 sticky-top">
  <a class="navbar-brand fw-bold" href="/">🎓 Alumni Career Intelligence</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="navMenu">
    <ul class="navbar-nav me-auto">
      <li class="nav-item"><a class="nav-link" href="/alumni/finder">Alumni Finder</a></li>
      <li class="nav-item"><a class="nav-link" href="/ai/finder">AI Finder</a></li>
      <li class="nav-item"><a class="nav-link" href="/insights">Insights</a></li>
      <li class="nav-item"><a class="nav-link" href="/advice">Advice</a></li>
      <% if (user.role === 'student') { %>
        <li class="nav-item"><a class="nav-link" href="/student/profile">My Profile</a></li>
      <% } else if (user.role === 'alumni') { %>
        <li class="nav-item"><a class="nav-link" href="/alumni/profile">My Profile</a></li>
        <li class="nav-item"><a class="nav-link" href="/alumni/career">Career Journey</a></li>
      <% } %>
    </ul>
    <form action="/auth/logout" method="POST" class="d-flex">
      <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
    </form>
  </div>
</nav>
<% } %>
