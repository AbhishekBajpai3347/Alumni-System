# ==========================================
# SERVER
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# POSTGRESQL (Neon)
# Get this from your Neon project dashboard -> Connection string
# Must include ?sslmode=require for Neon
# ==========================================
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# ==========================================
# JWT AUTH
# ==========================================
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# GROQ LLM
# https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# QDRANT
# For Qdrant Cloud, use the cluster URL + API key.
# For local Qdrant (docker run -p 6333:6333 qdrant/qdrant), leave API key blank.
# ==========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=alumni_profiles

# ==========================================
# ==========================================
# AI FINDER MATCH TUNING
# Raw cosine similarity from the local embedding model clusters in a narrow
# high band for this domain (every alumni document shares the same profile
# template), so it isn't a good 0-100% scale on its own. These two values
# calibrate it: results below MIN are dropped entirely (not shown as a
# "match" at all); MIN..MAX is stretched to the displayed 0-100%.
# Tune by trying a few real queries and adjusting until weak/strong matches
# look right -- there's no universally correct number.
SEMANTIC_MATCH_MIN_SCORE=0.40
SEMANTIC_MATCH_MAX_SCORE=0.90

# ==========================================
# EMBEDDING MODEL
# Groq does not serve an embeddings endpoint, so embeddings are generated
# LOCALLY inside the Node.js process using @xenova/transformers (ONNX
# runtime, no Python, no external API call, no extra API key needed).
# Model: Xenova/all-MiniLM-L6-v2 (JS port of sentence-transformers/all-MiniLM-L6-v2)
# Vector dimension: 384. See README "Embedding Model" section for details.
# The model weights (~90MB) are downloaded once and cached on first run.
EMBEDDING_DIMENSION=384
